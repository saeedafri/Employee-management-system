<mxfile host="app.diagrams.net" agent="EMS-backend-audit" version="24.7.0">
  <diagram id="flow" name="Flow (Current vs Gaps)">
    <mxGraphModel dx="1050" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="EMS — Expense / Reimbursement → Payroll → Accounting (end-to-end)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>

        <!-- Legend -->
        <mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="60" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="lg1" value="EXISTS (built &amp; live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="785" y="88" width="150" height="28" as="geometry"/></mxCell>
        <mxCell id="lg2" value="PARTIAL (model/stub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="88" width="150" height="28" as="geometry"/></mxCell>
        <mxCell id="lg3" value="MISSING (to build)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="785" y="128" width="150" height="28" as="geometry"/></mxCell>
        <mxCell id="lg4" value="Data model (Prisma)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="122" width="150" height="40" as="geometry"/></mxCell>

        <!-- Actors -->
        <mxCell id="emp" value="Employee" style="shape=umlActor;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="mgr" value="Manager / HR" style="shape=umlActor;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="fin" value="Finance / Accounting" style="shape=umlActor;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1050" width="40" height="80" as="geometry"/></mxCell>

        <!-- 1 Submit -->
        <mxCell id="n1" value="1. Submit claim&#10;POST /payroll/reimbursement-claims&#10;{category, amount, currency, proofUrl}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="160" y="120" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="g1" value="GAP: receipt file UPLOAD endpoint&#10;(proofUrl is a bare string today)&#10;+ ownership guard (submit for self only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="280" height="70" as="geometry"/></mxCell>

        <!-- 2 Cap -->
        <mxCell id="n2" value="2. Category monthly-cap check&#10;CLAIM_OVER_CAP 422 (per single claim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="160" y="240" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="g2" value="GAP: cap is per-claim, not per-MONTH&#10;aggregate — 10 sub-cap claims bypass it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="280" height="60" as="geometry"/></mxCell>

        <!-- 3 Approve -->
        <mxCell id="n3" value="3. Approve / Reject&#10;PATCH /payroll/reimbursement-claims/:id&#10;status → APPROVED | REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="160" y="470" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="g3" value="GAP: no approver↔employee relationship&#10;check (reuse assertCanApprove from BE-SEC-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="280" height="70" as="geometry"/></mxCell>

        <!-- 4 Attach to run -->
        <mxCell id="n4" value="4. Attach approved claim to a run&#10;ReimbursementClaim.runId (field exists)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="160" y="600" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="g4" value="GAP: no wiring that pulls APPROVED claims&#10;into a PayrollRun / PaymentBatch as a payable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="600" width="280" height="60" as="geometry"/></mxCell>

        <!-- 5 Disburse -->
        <mxCell id="n5" value="5. Disburse&#10;PaymentBatch → bank file (NACH/…)&#10;PayoutMethod (AES-GCM) + PayoutApproval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="160" y="710" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="g5" value="GAP: bank file covers PAYROLL net-pay only;&#10;reimbursement payout not represented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="710" width="280" height="70" as="geometry"/></mxCell>

        <!-- 6 PAID -->
        <mxCell id="n6" value="6. Mark PAID&#10;status → PAID (decideReimbursementClaim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="160" y="830" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="g6" value="GAP: PAID is a status flip, not tied to an&#10;actual settlement / payment reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="830" width="280" height="60" as="geometry"/></mxCell>

        <!-- 7 GL journal -->
        <mxCell id="n7" value="7. Accounting journal (payroll run)&#10;getRunJournal + exportRunJournal (CSV)&#10;by glAccountCode + costCenterRule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="160" y="1050" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="g7" value="GAP: journal is PAYROLL-RUN only — no&#10;reimbursement / invoice / advance postings;&#10;no persisted General Ledger, no double-entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="1040" width="290" height="90" as="geometry"/></mxCell>

        <!-- 8 Export -->
        <mxCell id="n8" value="8. Export / close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="160" y="1170" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="g8" value="GAP: no external export (Tally / QuickBooks /&#10;Xero / Zoho), no trial balance, no period close/lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="1170" width="290" height="50" as="geometry"/></mxCell>

        <!-- Data models column -->
        <mxCell id="dmT" value="Data models (Prisma) — already present" style="text;html=1;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="240" width="330" height="20" as="geometry"/></mxCell>
        <mxCell id="dm1" value="ReimbursementCategory (monthlyCap)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="270" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="dm2" value="ReimbursementClaim (SUBMITTED|APPROVED|REJECTED|PAID, runId, proofUrl)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="dm3" value="PayrollRun / PayrollInput / EmployeeSalary" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="dm4" value="PaymentBatch / PayoutMethod / PayoutApproval" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="460" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="dm5" value="ContractorInvoice / EmployeeLoan / Garnishment" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="520" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="dm6" value="MISSING models: ChartOfAccount, LedgerEntry (double-entry), AccountingPeriod" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="590" width="300" height="60" as="geometry"/></mxCell>

        <!-- edges main flow -->
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="emp" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="em3" style="endArrow=block;html=1;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="mgr" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e67" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e78" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef7" style="endArrow=block;html=1;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="fin" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="roadmap" name="Roadmap (phases)">
    <mxGraphModel dx="1050" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rt" value="Accounting &amp; Reimbursement — build roadmap (each phase ships + deploys independently)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell>

        <mxCell id="p0" value="P0 — Reimbursement hardening (small)&#10;• ownership guard on submit (self only)&#10;• approver↔employee guard on decide (reuse assertCanApprove)&#10;• per-MONTH aggregate cap (not per-claim)&#10;• receipt upload endpoint (authenticated, WebP/PDF, like docs)&#10;• employee self-service list (own claims)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="p1" value="P1 — Reimbursement → payout (medium)&#10;• pull APPROVED claims into a PaymentBatch/PayrollRun&#10;• disburse via existing bank-file + PayoutMethod&#10;• PAID tied to a real payment reference&#10;• notifications (submitted/approved/paid)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="p2" value="P2 — General Ledger core (large)&#10;• ChartOfAccount model + CRUD&#10;• LedgerEntry (double-entry: debit/credit, source ref)&#10;• post from PayrollRun (extend getRunJournal)&#10;• post from Reimbursement PAID + ContractorInvoice&#10;• AccountingPeriod (open/closed) + lock" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="330" height="150" as="geometry"/></mxCell>

        <mxCell id="p3" value="P3 — Reporting &amp; close (medium)&#10;• trial balance, GL by account/cost-center&#10;• period close workflow + immutability&#10;• accrual vs cash basis toggle&#10;• audit trail on every posting (AuditLog)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="p4" value="P4 — External integrations (medium)&#10;• export: Tally / QuickBooks / Xero / Zoho Books&#10;• journal CSV/API mapping per provider&#10;• webhook out on period close (SSRF-guarded, BE-SEC-6)&#10;• multi-currency consolidation (needs BE-PAY-4 FX)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="410" y="250" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="p5" value="Cross-cutting (every phase)&#10;• API_MAPPING.md + Swagger per endpoint&#10;• node:test oracle per money rule&#10;• Decimal(18,4) + roundMoney (currency-aware)&#10;• tenant + role isolation; live-verify on Hostinger" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="250" width="330" height="140" as="geometry"/></mxCell>

        <mxCell id="re01" style="endArrow=block;html=1;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re12" style="endArrow=block;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re23" style="endArrow=block;html=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re34" style="endArrow=block;html=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
